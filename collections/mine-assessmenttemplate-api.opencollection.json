{
  "opencollection": "1.0.0",
  "info": {
    "name": "MineOS Aispm AssessmentTemplate API",
    "version": "v1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "AssessmentTemplate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves a list of assessment templates available for the company.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.portal.saymine.com/api/public-v1/template/List",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The number of items to skip before starting to collect the result set."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return in the result set."
              }
            ]
          },
          "docs": "Retrieves a list of assessment templates available for the company."
        }
      ]
    }
  ],
  "bundled": true
}