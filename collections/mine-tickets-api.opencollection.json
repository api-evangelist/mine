              }
            ]
          },
          "docs": "Returns the workflow id, display name, and the list of integrations attached to the ticket's workflow."
        },
        {
          "info": {
            "name": "Change the workflow assigned to a ticket",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.portal.saymine.com/api/ticket/:ticketId/workflow",
            "params": [
              {
                "name": "ticketId",
                "value": "3664feb0-b48c-4a8a-a81d-1303a4efc64f",
